{
  "name": "react-native-kimoyo-oju",
  "version": "0.1.0",
  "description": "Nitro-powered native bindings for Kimoyo Oju 3D/XR renderer",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "cpp",
    "android",
    "ios",
    "nitrogen",
    "plugin",
    "app.plugin.js",
    "react-native-kimoyo-oju.podspec",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build && yarn build:plugin",
    "build:plugin": "tsc --project plugin/tsconfig.json",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib plugin/build",
    "nitrogen": "nitrogen generate",
    "prepack": "bob build && yarn build:plugin"
  },
  "keywords": [
    "react-native",
    "nitro",
    "kimoyo-oju",
    "3d",
    "xr",
    "vr",
    "ar",
    "openxr",
    "meta-quest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/user/kimoyo-oju.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/user/kimoyo-oju/issues"
  },
  "homepage": "https://github.com/user/kimoyo-oju#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@expo/config-plugins": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.17.0",
    "react-native-builder-bob": "^0.35.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.83.0",
    "react-native-nitro-modules": ">=0.32.0"
  },
  "nitro": {
    "cxxNamespace": [
      "kimoyooju",
      "nitro"
    ],
    "ios": {
      "iosModuleName": "KimoyoOjuNitro"
    },
    "android": {
      "androidNamespace": [
        "kimoyooju",
        "nitro"
      ],
      "androidCxxLibName": "KimoyoOjuNitro"
    },
    "autolinking": {}
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
